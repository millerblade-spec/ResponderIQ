# Copy to .env.local for local development. Never commit real secrets --
# this file should only ever contain placeholders.

# Postgres connection string. Required for every database read/write
# (lib/db/client.ts throws immediately if this is missing -- there is
# no fallback). Any standard Postgres works; nothing here is tied to
# one hosting provider.
DATABASE_URL="postgres://user:password@localhost:5432/responderiq"

# Signs and verifies admin session cookies (lib/auth/session.ts).
# Must be at least 16 characters -- creating or verifying a session
# fails closed (never silently allows access) if this is missing or
# too short. Generate one with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string-at-least-16-characters"

# Used only by scripts/seed-admin.ts (npm run db:seed-admin), to create
# or reset the one admin account. Not read by the running application
# itself. Password must be at least 12 characters.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-a-real-password-at-least-12-characters"

# Not a separate variable the app reads -- when running tests locally,
# point DATABASE_URL at a second database (e.g. one named
# responderiq_test) so integration tests never touch your dev data.
# Example: DATABASE_URL="postgres://user:password@localhost:5432/responderiq_test" npm test

# Cookie security (app/admin/login/actions.ts) is automatic, not an
# env var to set: the session cookie is marked `secure` only when
# VERCEL=1 is present (which Vercel's own platform sets automatically
# in every environment it deploys to, and only those are HTTPS). Local
# `next dev` / `next start` are plain HTTP, where a `secure` cookie
# would never be sent back by the browser -- this is why the flag is
# conditional rather than always on.
